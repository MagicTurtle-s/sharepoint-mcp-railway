# SharePoint MCP Railway - Environment Variables
# Copy this file to .env and configure with your credentials

# ===== REQUIRED: Azure AD Application Credentials =====
# You can use either the new naming convention or legacy names (both supported)

# Option 1: New naming (recommended for Railway)
AZURE_CLIENT_ID=your-azure-app-client-id-here
AZURE_CLIENT_SECRET=your-azure-app-client-secret-here
AZURE_TENANT_ID=your-microsoft-tenant-id-here

# Option 2: Legacy naming (for backwards compatibility)
# SHP_ID_APP=your-azure-app-client-id-here
# SHP_ID_APP_SECRET=your-azure-app-client-secret-here
# SHP_TENANT_ID=your-microsoft-tenant-id-here

# ===== MULTI-SITE CONFIGURATION =====

# Legacy single-site mode (OPTIONAL - only needed for backwards compatibility)
# If not set, server runs in multi-site mode where site_url is specified per request
# SHP_SITE_URL=https://your-tenant.sharepoint.com/sites/your-site

# Default document library (optional, defaults to "Shared Documents")
SHP_DOC_LIBRARY=Shared Documents

# ===== CUSTOMER SITE MAPPINGS (OPTIONAL) =====
# Map friendly customer names to SharePoint site URLs
# Format: CustomerName:https://site-url,AnotherCustomer:https://site-url
# Example:
# CUSTOMER_SITES=Acme Corp:https://contoso.sharepoint.com/sites/acme-corp,Wayne Enterprises:https://contoso.sharepoint.com/sites/wayne-ent

# ===== PERFORMANCE TUNING (OPTIONAL) =====
# Limits for folder tree operations
SHP_MAX_DEPTH=15
SHP_MAX_FOLDERS_PER_LEVEL=100
SHP_LEVEL_DELAY=0.5

# ===== LOGGING (OPTIONAL) =====
# LOG_LEVEL=INFO

# ===== RAILWAY DEPLOYMENT =====
# Railway automatically provides PORT environment variable
# No additional configuration needed for Railway deployment
